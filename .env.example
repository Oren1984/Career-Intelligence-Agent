# .env.example — copy to .env and replace every "change-me" value.
# .env is git-ignored and excluded from the Docker build context.

# ── PostgreSQL (Docker Compose) ───────────────────────────────────────────────
# Use URL-safe passwords (letters, digits, - _ .): they are embedded in connection URLs.
# Owner role: used only by the one-shot `migrate` service.
POSTGRES_USER=career_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=career
# Least-privilege role used by the dashboard (DML only, row-level security enforced).
APP_DB_USER=career_app
APP_DB_PASSWORD=change-me-app-password
# Host port for local tools/tests (bound to 127.0.0.1 only).
DB_HOST_PORT=5433
APP_HOST_PORT=8508

# ── Running outside Docker ────────────────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://career_app:change-me-app-password@127.0.0.1:5433/career
# MIGRATION_DATABASE_URL=postgresql+psycopg://career_owner:change-me-owner-password@127.0.0.1:5433/career
# WORKSPACE=personal            # workspace used by command-line scripts (personal | demo)

# ── Authentication ────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60
# USERS_FILE=config/users.yaml  # default location of the local credentials file

# ── Search / embeddings ───────────────────────────────────────────────────────
# SEARCH_BACKEND=auto           # auto (vector with TF-IDF fallback) | tfidf
# VECTOR_SCORE_FLOOR=0.80       # cosine similarity treated as "no relevance"
# MODEL_CACHE_DIR=data/models   # local model cache (Docker bakes it into /opt/models)
# EMBEDDING_ALLOW_DOWNLOAD=true # allow the one-time model download outside Docker

# ── Existing options ──────────────────────────────────────────────────────────
GMAIL_ENABLED=false
GMAIL_MODE=mock
ENABLE_FUZZY_DEDUP=true
ENABLE_SEMANTIC_SCORING=true
