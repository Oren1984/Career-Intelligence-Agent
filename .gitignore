# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
/venv/
/.venv/

# Environment variables
.env

# Local login credentials (bcrypt hashes) — managed by scripts/create_user.py
config/users.yaml
# Personal local-login notes (owner username, URL, password instructions)
LOCAL_LOGIN.md

# Database files
data/*.db

# Local embedding model cache (downloaded on first use)
data/models/

# Pytest and build artifacts
.pytest_cache/
*.egg-info/
dist/
build/

# IDE and operating-system files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Local AI Assistant Configuration
# Claude configuration and local working files are not part of the repository.
.claude/
CLAUDE.md

# Internal Documentation
# Private files in docs/ (e.g. the personal Job_Search_Tracker.xlsx) stay local;
# only the public project documentation in docs/documentation/ is tracked.
docs/*
!docs/documentation/
/documentation/

# Personal tracker workbooks and exports, database backups
Job_Search_Tracker*.xlsx
job_search_tracker_*.xlsx
backups/
exports/
*.dump

# ── Local Knowledge Base
# Personal files in knowledge_base/ are never committed.
# Everything except the placeholder is personal (mounted read-only into Docker).
knowledge_base/*
!knowledge_base/.gitkeep

# Personal Profile
data/personal_profile.json

# Local RAG Index
data/knowledge_index/
# Personal V2 work plan (local only)
V2_WORK_PLAN.md
